: true, "compiled_code": "-- Dimension MES: una fila por cada mes que tiene ventas.\n-- Grano: un mes.\n-- ref('stg_ventas') es el modelo stg_ventas.sql: dbt lo crea primero y luego este.\n\n-- select distinct = traer las filas SIN repetir: cada mes aparece una sola vez\nselect distinct\n    -- replace quita el guion: '2023-04' -> '202304'; cast(... as integer) lo vuelve\n    -- numero: 202304. \"as mes_id\" le pone ese nombre a la columna (la llave)\n    cast(replace(periodo, '-', '') as integer)      as mes_id,\n    -- El periodo como texto: '2023-04'\n    periodo,\n    -- left(periodo, 4) toma los 4 primeros caracteres: '2023' -> 2023\n    cast(left(periodo, 4) as integer)               as anio,\n    -- right(periodo, 2) toma los 2 ultimos: '04' -> 4\n    cast(right(periodo, 2) as integer)              as mes,\n    -- El trimestre: (mes + 2) dividido 3, sin decimales (//).\n    -- Ejemplo: enero (1+2)//3 = 1; abril (4+2)//3 = 2; diciembre (12+2)//3 = 4\n    (cast(right(periodo, 2) as integer) + 2) // 3   as trimestre\n-- De donde: el modelo stg_ventas\nfrom \"observatorio\".\"main\".\"stg_ventas\"", "relation_name": "\"observatorio\".\"main\".\"dim_mes\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-04T01:13:47.145801Z", "completed_at": "2026-11-04T01:13:47.165500Z"}, {"name": "execute", "started_at": "2026-11-04T01:13:47.166179Z", "completed_at": "2026-11-04T01:13:47.180792Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.03860282897949219, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.observatorio.not_null_dim_mes_mes_id.8cdd5f6211", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect mes_id\nfrom \"observatorio\".\"main\".\"dim_mes\"\nwhere mes_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-04T01:13:47