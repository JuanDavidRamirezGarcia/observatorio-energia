atorio.dim_fuente", "compiled": true, "compiled_code": "\n\nselect 1 as fuente_key, 'EnerAndes' as nombre_fuente, 'Ventas de Energ\u00eda' as descripcion\nunion all\nselect 2, 'XM', 'Mercado Mayorista y Sistema Interconectado'\nunion all\nselect 3, 'NOAA', '\u00cdndice Oce\u00e1nico El Ni\u00f1o (ONI)'\nunion all\nselect 4, 'IDEAM', 'Estaciones Climatol\u00f3gicas Antioquia'", "relation_name": "\"observatorio\".\"main\".\"dim_fuente\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-31T15:04:04.871944Z", "completed_at": "2026-10-31T15:04:04.874047Z"}, {"name": "execute", "started_at": "2026-10-31T15:04:04.874328Z", "completed_at": "2026-10-31T15:04:04.902347Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.03131294250488281, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.observatorio.dim_municipio", "compiled": true, "compiled_code": "\n\nwith municipios_unicos as (\n    select distinct\n        divipola,\n        municipio\n    from 'data/silver/enerandes_ventas.parquet'\n    where divipola is not null\n)\nselect\n    row_number() over (order by divipola) as municipio_id,\n    divipola,\n    municipio,\n    'Antioquia' as departamento\nfrom municipios_unicos", "relation_name": "\"observatorio\".\"main\".\"dim_municipio\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-31T15:04:04.905346Z", "completed_at": "2026-10-31T15:04:04.907421Z"}, {"name": "execute", "started_at": "2026-10-31T15:04:04.907708Z", "completed_at": "2026-10-31T15:04:04.931047Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.026978731155395508, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.observatorio.dim_recurso", "compiled": true, "compiled_code": "\n\nwith recursos as (\n    select distinct\n        'REC_EMBALSE' as codigo_