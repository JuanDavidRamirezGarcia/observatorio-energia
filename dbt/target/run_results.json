{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.6", "generated_at": "2026-11-08T01:29:20.603948Z", "invocation_id": "2c00086d-6a2f-4577-a63d-3be44e243f18", "invocation_started_at": "2026-11-08T01:29:14.862332Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T01:29:16.331553Z", "completed_at": "2026-11-08T01:29:16.339938Z"}, {"name": "execute", "started_at": "2026-11-08T01:29:16.340424Z", "completed_at": "2026-11-08T01:29:16.532476Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.2026512622833252, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.observatorio.dim_fecha", "compiled": true, "compiled_code": "\n\nwith rango_fechas as (\n    select unnest(generate_series(date '2023-01-01', date '2026-12-31', interval '1 day')) as fecha\n),\nnoaa as (\n    select distinct periodo, fase_enso \n    from 'data/silver/noaa_oni.parquet'\n)\nselect\n    cast(strftime(rf.fecha, '%Y%m%d') as integer) as fecha_key,\n    rf.fecha,\n    year(rf.fecha) as anio,\n    month(rf.fecha) as mes,\n    day(rf.fecha) as dia,\n    strftime(rf.fecha, '%Y-%m') as periodo_yyyy_mm,\n    quarter(rf.fecha) as trimestre,\n    dayofweek(rf.fecha) as dia_semana,\n    coalesce(n.fase_enso, 'Neutral') as fase_enso\nfrom rango_fechas rf\nleft join noaa n on strftime(rf.fecha, '%Y-%m') = n.periodo", "relation_name": "\"observatorio\".\"main\".\"dim_fecha\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T01:29:16.538973Z", "completed_at": "2026-11-08T01:29:16.540972Z"}, {"name": "execute", "started_at": "2026-11-08T01:29:16.541555Z", "completed_at": "2026-11-08T01:29:16.584257Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.05000472068786621, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.observatorio.dim_fuente", "compiled": true, "compiled_code": "\n\nselect 1 as fuente_key, 'EnerAndes' as nombre_fuente, 'Ventas de Energ\u00eda' as descripcion\nunion all\nselect 2, 'XM', 'Mercado Mayorista y Sistema Interconectado'\nunion all\nselect 3, 'NOAA', '\u00cdndice Oce\u00e1nico El Ni\u00f1o (ONI)'\nunion all\nselect 4, 'IDEAM', 'Estaciones Climatol\u00f3gicas Antioquia'", "relation_name": "\"observatorio\".\"main\".\"dim_fuente\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T01:29:16.601728Z", "completed_at": "2026-11-08T01:29:16.606482Z"}, {"name": "execute", "started_at": "2026-11-08T01:29:16.607178Z", "completed_at": "2026-11-08T01:29:16.640896Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.042410850524902344, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.observatorio.dim_municipio", "compiled": true, "compiled_code": "\n\nwith municipios_unicos as (\n    select distinct\n        divipola,\n        municipio\n    from 'data/silver/enerandes_ventas.parquet'\n    where divipola is not null\n)\nselect\n    row_number() over (order by divipola) as municipio_id,\n    divipola,\n    municipio,\n    'Antioquia' as departamento\nfrom municipios_unicos", "relation_name": "\"observatorio\".\"main\".\"dim_municipio\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T01:29:16.646038Z", "completed_at": "2026-11-08T01:29:16.650572Z"}, {"name": "execute", "started_at": "2026-11-08T01:29:16.651074Z", "completed_at": "2026-11-08T01:29:16.857648Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.21331048011779785, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.observatorio.dim_recurso", "compiled": true, "compiled_code": "\n\nwith catalogo as (\n    select distinct\n        trim(cast(recurso_code as varchar)) as codigo_recurso,\n        max(nullif(trim(recurso_name), '')) as nombre_recurso,\n        max(nullif(trim(recurso_type), '')) as tipo_generacion,\n        max(nullif(trim(recurso_enersource), '')) as fuente_energia,\n        max(nullif(trim(recurso_companycode), '')) as empresa,\n        max(nullif(trim(recurso_disp), '')) as disponibilidad,\n        max(nullif(trim(recurso_state), '')) as estado\n    from 'data/silver/xm_listado_recursos.parquet'\n    where recurso_code is not null\n      and trim(cast(recurso_code as varchar)) <> ''\n    group by trim(cast(recurso_code as varchar))\n),\nrecursos_historicos as (\n    select distinct\n        trim(cast(g.code as varchar)) as codigo_recurso\n    from 'data/silver/xm_generacion.parquet' g\n    left join catalogo c\n        on trim(cast(g.code as varchar)) = c.codigo_recurso\n    where g.code is not null\n      and trim(cast(g.code as varchar)) <> ''\n      and c.codigo_recurso is null\n),\nrecursos as (\n    select\n        codigo_recurso,\n        coalesce(nombre_recurso, codigo_recurso) as nombre_recurso,\n        coalesce(tipo_generacion, 'NO IDENTIFICADO EN CATALOGO') as tipo_generacion,\n        fuente_energia,\n        empresa,\n        disponibilidad,\n        estado\n    from catalogo\n    union all\n    select\n        codigo_recurso,\n        codigo_recurso as nombre_recurso,\n        'NO IDENTIFICADO EN CATALOGO' as tipo_generacion,\n        null as fuente_energia,\n        'XM' as empresa,\n        null as disponibilidad,\n        null as estado\n    from recursos_historicos\n)\nselect\n    row_number() over (order by codigo_recurso) as recurso_key,\n    *\nfrom recursos", "relation_name": "\"observatorio\".\"main\".\"dim_recurso\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T01:29:16.863591Z", "completed_at": "2026-11-08T01:29:16.867382Z"}, {"name": "execute", "started_at": "2026-11-08T01:29:16.868147Z", "completed_at": "2026-11-08T01:29:16.902140Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04086637496948242, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.observatorio.dim_segmento", "compiled": true, "compiled_code": "\n\nwith segmentos_unicos as (\n    select distinct\n        segmento,\n        tipo_compra\n    from 'data/silver/enerandes_ventas.parquet'\n    where segmento is not null\n)\nselect\n    row_number() over (order by segmento, tipo_compra) as segmento_id,\n    segmento,\n    tipo_compra\nfrom segmentos_unicos", "relation_name": "\"observatorio\".\"main\".\"dim_segmento\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T01:29:16.908072Z", "completed_at": "2026-11-08T01:29:16.912541Z"}, {"name": "execute", "started_at": "2026-11-08T01:29:16.913363Z", "completed_at": "2026-11-08T01:29:16.967538Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.061720848083496094, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.observatorio.fact_mercado_horario", "compiled": true, "compiled_code": "\n\nselect\n    cast(strftime(p.fecha, '%Y%m%d') as integer) as fecha_key,\n    p.fecha,\n    p.hora,\n    p.precio_bolsa_kwh,\n    d.demanda_kwh\nfrom 'data/silver/xm_precio_bolsa.parquet' p\nleft join 'data/silver/xm_demanda.parquet' d \n    on p.fecha = d.fecha and p.hora = d.hora", "relation_name": "\"observatorio\".\"main\".\"fact_mercado_horario\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-08T01:29:16.972856Z", "completed_at": "2026-11-08T01:29:16.975297Z"}, {"name": "execute", "started_at": "2026-11-08T01:29:16.975762Z", "completed_at": "2026-11-08T01:29:17.022136Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.050949811935424805, "adapter_response": {"_message": "OK"}, "message": "OK